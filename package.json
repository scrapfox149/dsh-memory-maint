{
  "name": "dsh-memory-maint",
  "version": "0.1.0",
  "description": "记忆库维护插件：去重、衰减、变更、体检、查询。逻辑在 Python（自包含），Node 层只做工具注册与转发。",
  "type": "module",
  "license": "MIT",
  "keywords": ["dsh-plugin", "deepseek-harness", "dsh", "memory", "maintenance", "cordis-plugin"],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "modules/",
    "py-core/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
